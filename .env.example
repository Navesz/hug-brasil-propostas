# Company and contact details shown as defaults on a new proposal.
# These used to be hardcoded in src/lib/defaultProposal.ts, which published a real
# person's name and mobile number in a public repository. Fill them in on the host
# (Vercel project settings, or a local .env.local) and the app behaves as before.
NEXT_PUBLIC_EMPRESA_NOME=
NEXT_PUBLIC_EMPRESA_CNPJ=
NEXT_PUBLIC_EMPRESA_CONTATO=
NEXT_PUBLIC_EMPRESA_ENDERECO=
NEXT_PUBLIC_EMPRESA_SITE=
NEXT_PUBLIC_REPRESENTANTE_NOME=
NEXT_PUBLIC_REPRESENTANTE_CNPJ=

# Remote kill switch consulted by src/lib/accessControl.ts on load and every 5min.
# If this URL stops resolving, AccessGate blocks every user, so it must point at a
# location that will outlive any repository rename or visibility change.
NEXT_PUBLIC_ACCESS_CONFIG_URL=https://raw.githubusercontent.com/Navesz/hug-brasil-propostas/main/config/access.json
